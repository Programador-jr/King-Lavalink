# Copie para .env e substitua por um segredo forte e exclusivo.
# Obrigatória para iniciar o painel ou o launcher Java.
PANEL_PASSWORD=replace-with-a-long-random-password

# Painel local em Python (opcional).
PANEL_PORT=8080

# Opcional: por padrão, o painel lê a conexão de application.yml.
# Defina estes valores apenas se o Lavalink estiver em outro host ou porta.
# LAVALINK_HOST=127.0.0.1
# LAVALINK_PORT=2333
# LAVALINK_SERVER_PASSWORD=replace-with-your-lavalink-api-password
